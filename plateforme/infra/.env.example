# CERVEAU — template for infra/.env (ignored by git). Values stay empty here on purpose:
# docker compose refuses to start while one is empty (R7, l'inconnu bloque).
# Create the real file once, without ever displaying the values:
#   uv run python infra/scripts/generate_secrets.py
# Never commit infra/.env; never paste a value into a prompt, a log or a memory (R6).

# PostgreSQL superuser of the `cerveau` database (profile core).
POSTGRES_PASSWORD=
# Role `langfuse` created by infra/postgres/init/10-init.sh (profile observability).
LANGFUSE_DB_PASSWORD=

# Langfuse v4 (profile observability). ENCRYPTION_KEY must be 64 hexadecimal characters.
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
