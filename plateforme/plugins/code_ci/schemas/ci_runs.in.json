{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "description": "Identifiant du dépôt dans la liste blanche",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Repo",
      "type": "string"
    },
    "branch": {
      "anyOf": [
        {
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]{0,99}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Branche (absente : toutes)",
      "title": "Branch"
    },
    "max_runs": {
      "default": 10,
      "description": "Nombre de runs (1 à 20)",
      "maximum": 20,
      "minimum": 1,
      "title": "Max Runs",
      "type": "integer"
    }
  },
  "required": [
    "repo"
  ],
  "title": "ci_runsArguments"
}
