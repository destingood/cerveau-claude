{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "column",
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Pytest": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "echec",
            "erreur",
            "aucun_test",
            "non_lance",
            "delai"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "failed": {
          "items": {
            "type": "string"
          },
          "title": "Failed",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "more_failures": {
          "title": "More Failures",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "note",
        "counts",
        "failed",
        "errors",
        "more_failures"
      ],
      "title": "Pytest",
      "type": "object"
    },
    "RuffCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "echec",
            "erreur",
            "aucun_test",
            "non_lance",
            "delai"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Count"
        },
        "by_code": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Code",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "more_diagnostics": {
          "title": "More Diagnostics",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "note",
        "count",
        "by_code",
        "diagnostics",
        "more_diagnostics"
      ],
      "title": "RuffCheck",
      "type": "object"
    },
    "RuffFormat": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "echec",
            "erreur",
            "aucun_test",
            "non_lance",
            "delai"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Count"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "more_files": {
          "title": "More Files",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "note",
        "count",
        "files",
        "more_files"
      ],
      "title": "RuffFormat",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "The throwaway copy the containers read.",
      "properties": {
        "files": {
          "title": "Files",
          "type": "integer"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "withheld": {
          "items": {
            "type": "string"
          },
          "title": "Withheld",
          "type": "array"
        },
        "more_withheld": {
          "title": "More Withheld",
          "type": "integer"
        },
        "skipped": {
          "items": {
            "type": "string"
          },
          "title": "Skipped",
          "type": "array"
        },
        "more_skipped": {
          "title": "More Skipped",
          "type": "integer"
        },
        "removed": {
          "title": "Removed",
          "type": "boolean"
        }
      },
      "required": [
        "files",
        "bytes",
        "withheld",
        "more_withheld",
        "skipped",
        "more_skipped",
        "removed"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repo": {
      "title": "Repo",
      "type": "string"
    },
    "rev": {
      "title": "Rev",
      "type": "string"
    },
    "sha": {
      "title": "Sha",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "ruff_check": {
      "$ref": "#/$defs/RuffCheck"
    },
    "ruff_format": {
      "$ref": "#/$defs/RuffFormat"
    },
    "pytest": {
      "$ref": "#/$defs/Pytest"
    },
    "budget_seconds": {
      "title": "Budget Seconds",
      "type": "number"
    }
  },
  "required": [
    "repo",
    "rev",
    "sha",
    "source",
    "ruff_check",
    "ruff_format",
    "pytest",
    "budget_seconds"
  ],
  "title": "ChecksResult",
  "type": "object"
}
