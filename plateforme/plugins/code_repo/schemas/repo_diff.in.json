{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "description": "Identifiant du dépôt dans la liste blanche",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Repo",
      "type": "string"
    },
    "base": {
      "description": "Révision de départ (avant les changements)",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/~^-]{0,99}$",
      "title": "Base",
      "type": "string"
    },
    "head": {
      "default": "HEAD",
      "description": "Révision d'arrivée (après les changements)",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/~^-]{0,99}$",
      "title": "Head",
      "type": "string"
    }
  },
  "required": [
    "repo",
    "base"
  ],
  "title": "repo_diffArguments"
}
