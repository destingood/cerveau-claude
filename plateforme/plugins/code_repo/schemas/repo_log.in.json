{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "description": "Identifiant du dépôt dans la liste blanche",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Repo",
      "type": "string"
    },
    "rev": {
      "default": "HEAD",
      "description": "Révision de départ (branche, étiquette, commit)",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/~^-]{0,99}$",
      "title": "Rev",
      "type": "string"
    },
    "max_count": {
      "default": 20,
      "description": "Nombre de commits (1 à 50)",
      "maximum": 50,
      "minimum": 1,
      "title": "Max Count",
      "type": "integer"
    }
  },
  "required": [
    "repo"
  ],
  "title": "repo_logArguments"
}
