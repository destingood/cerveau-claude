{"id": "cr-011", "tool": "repo_diff", "allowlist": "cerveau", "arguments": {"repo": "cerveau", "base": "HEAD~1"}, "expected": {"is_error": true, "contains": "recouvre le dépôt CERVEAU (ADR-047)"}}
{"id": "cr-012", "tool": "repo_diff", "arguments": {"repo": "exemple", "base": "HEAD~1"}, "expected": {"is_error": false, "contains": "\"withheld\": [\".env\"]", "absent": ["VALEUR-DU-FICHIER-ENV"]}}
{"id": "cr-013", "tool": "repo_diff", "arguments": {"repo": "exemple", "base": "HEAD~1"}, "expected": {"is_error": false, "contains": "+TOKEN = \\\"[MASQUÉ]\\\""}}
