{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feed": {
      "description": "Identifiant du flux dans la liste blanche",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "title": "Feed",
      "type": "string"
    },
    "since": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Seulement les entrées datées de ce jour ou après (AAAA-MM-JJ)",
      "title": "Since"
    },
    "max_entries": {
      "default": 10,
      "description": "Nombre d'entrées (1 à 20)",
      "maximum": 20,
      "minimum": 1,
      "title": "Max Entries",
      "type": "integer"
    }
  },
  "required": [
    "feed"
  ],
  "title": "feed_readArguments"
}
