          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "benchmark",
        "beta",
        "sessions",
        "note"
      ],
      "title": "BetaView",
      "type": "object"
    },
    "Concentration": {
      "additionalProperties": false,
      "description": "Securities only, on the invested value.",
      "properties": {
        "herfindahl": {
          "$ref": "#/$defs/Figure"
        },
        "effective_lines": {
          "$ref": "#/$defs/Figure"
        }
      },
