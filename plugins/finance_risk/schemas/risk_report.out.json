    "Figure": {
      "additionalProperties": false,
      "description": "A number for the planner. ``unit``: a currency code, ``%`` (``value`` is a fraction),\n``XXX/EUR`` (units of XXX for one euro), ``titres``, ``jours``, ``séances``, ``ans`` or\n``score`` (in [0, 1]).",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value",
        "display",
        "unit"
      ],
      "title": "Figure",
      "type": "object"
    },
