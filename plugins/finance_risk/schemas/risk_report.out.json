        },
        "window": {
          "$ref": "#/$defs/Figure"
        },
        "first_session": {
          "format": "date",
          "title": "First Session",
          "type": "string"
        },
        "last_session": {
          "format": "date",
          "title": "Last Session",
          "type": "string"
        },
        "confidence_levels": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Confidence Levels",
          "type": "array"
        },
        "horizons": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Horizons",
          "type": "array"
        },
        "annualisation": {
          "$ref": "#/$defs/Figure"
        },
        "monte_carlo_draws": {
