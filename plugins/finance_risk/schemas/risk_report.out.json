    "QualityCheck": {
      "additionalProperties": false,
      "description": "The recorded quality of the series a calculation reads, against\n``min_quality_score_above_N1`` (D12): below it, or while it cannot be judged, a decision\nstays capped at N1 and the output says so with the scores (plan of phase 2, §3).",
      "properties": {
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "enum": [
            "suffisante",
            "insuffisante",
            "non_evaluable"
          ],
          "title": "Gate",
          "type": "string"
        },
        "decision_cap": {
          "anyOf": [
            {
              "const": "N1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Cap"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SeriesScore"
          },
          "title": "Series",
          "type": "array"
        },
        "below": {
          "items": {
            "type": "string"
          },
          "title": "Below",
          "type": "array"
        },
        "not_evaluated": {
          "items": {
            "type": "string"
          },
          "title": "Not Evaluated",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "threshold",
        "gate",
        "decision_cap",
        "series",
        "below",
        "not_evaluated"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "RateSplit": {
      "additionalProperties": false,
      "description": "The rate shock in two parts: the bonds by their duration [Approximation], the other\nsecurities by an OLS of their daily euro P&L on the daily change of the risk-free rate, on\nthe window [Estimation]. A p-value far from zero means the estimate is not distinguishable\nfrom no sensitivity at all.",
      "properties": {
        "series": {
          "title": "Series",
          "type": "string"
        },
        "duration_lines": {
          "items": {
            "type": "string"
          },
          "title": "Duration Lines",
          "type": "array"
        },
        "duration_eur": {
          "$ref": "#/$defs/Figure"
        },
        "estimated_lines": {
          "items": {
            "type": "string"
          },
          "title": "Estimated Lines",
          "type": "array"
        },
        "estimated_eur": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard_error_eur": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ]
        },
        "p_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "series",
        "duration_lines",
        "duration_eur",
        "estimated_lines",
        "estimated_eur",
        "standard_error_eur",
        "p_value",
        "sessions"
      ],
      "title": "RateSplit",
      "type": "object"
    },
    "SeriesScore": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
