        "second": {
          "title": "Second",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Figure"
        }
      },
      "required": [
        "first",
        "second",
        "value"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "DrawdownView": {
      "additionalProperties": false,
      "description": "Losses from the running peak, negative fractions, on the window.",
