      "type": "object"
    },
    "ExposureChange": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "title": "Line",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/Figure"
        },
        "after": {
          "$ref": "#/$defs/Figure"
        },
