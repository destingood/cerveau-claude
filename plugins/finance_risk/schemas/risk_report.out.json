        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "value_eur": {
          "$ref": "#/$defs/Figure"
        },
        "weight": {
          "$ref": "#/$defs/Figure"
        },
        "volatility": {
          "$ref": "#/$defs/Figure"
        },
        "marginal": {
          "$ref": "#/$defs/Figure"
        },
        "contribution": {
          "$ref": "#/$defs/Figure"
        },
        "risk_share": {
          "$ref": "#/$defs/Figure"
        },
        "var_eur": {
