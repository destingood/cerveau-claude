{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BacktestRow": {
      "additionalProperties": false,
      "description": "Kupiec test of the historical VaR at one session, current weights [Hypothèse].",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Figure"
        },
        "sessions": {
          "$ref": "#/$defs/Figure"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "exceptions": {
          "$ref": "#/$defs/Figure"
        },
        "expected": {
          "$ref": "#/$defs/Figure"
        },
        "statistic": {
          "$ref": "#/$defs/Figure"
        },
        "p_value": {
          "$ref": "#/$defs/Figure"
        },
        "significance": {
          "$ref": "#/$defs/Figure"
        },
        "verdict": {
          "enum": [
            "rejete",
            "non_rejete"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "sessions",
        "complete",
        "exceptions",
        "expected",
        "statistic",
        "p_value",
        "significance",
        "verdict"
      ],
      "title": "BacktestRow",
      "type": "object"
    },
    "BetaView": {
      "additionalProperties": false,
