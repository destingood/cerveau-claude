      "type": "object"
    },
    "LineContribution": {
      "additionalProperties": false,
      "description": "Euler split; volatilities annualized; VaR in euros at one session, parametric.",
      "properties": {
        "line": {
          "title": "Line",
          "type": "string"
        },
        "nature": {
          "enum": [
            "titre",
            "liquidites"
