        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "rates": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateSplit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
